<?xml version="1.0"?>
<Container version="2">
  <Name>evcc-calendar</Name>
  <Repository>ghcr.io/cmdrsabre/evcc-calendar:latest</Repository>
  <Registry>https://github.com/cmdrsabre/evcc-calendar/pkgs/container/evcc-calendar</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/cmdrsabre/evcc-calendar/issues</Support>
  <Project>https://github.com/cmdrsabre/evcc-calendar</Project>
  <ReadMe>https://github.com/cmdrsabre/evcc-calendar/blob/main/README.md</ReadMe>
  <TemplateURL>https://raw.githubusercontent.com/cmdrsabre/evcc-calendar/main/templates/evcc-calendar.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/cmdrsabre/evcc-calendar/main/templates/icon.png</Icon>
  <Overview>Sets a one-time evcc charging plan (target SoC and time) for your car from calendar appointments read through Home Assistant. Starts in dry-run mode: nothing is written until you set dry_run to false in config.yaml. On first start an example config.yaml is created in the appdata folder; edit it, then restart the container. Requires evcc, Home Assistant and an OpenRouteService API key.</Overview>
  <Category>HomeAutomation: Tools:</Category>
  <WebUI>http://[IP]:[PORT:80]/</WebUI>
  <ExtraParams>--user 99:100 --sysctl net.ipv4.ip_unprivileged_port_start=0</ExtraParams>
  <License>MIT</License>
  <Config Name="Web UI port" Target="80" Default="8180" Mode="tcp" Description="Port of the web UI" Type="Port" Display="always" Required="true" Mask="false">8180</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/evcc-kalender" Mode="rw" Description="Holds config.yaml, state.db and the optional personal/ folder" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/evcc-kalender</Config>
  <Config Name="HA_TOKEN" Target="HA_TOKEN" Default="" Mode="" Description="Home Assistant long-lived access token" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="EVCC_API_KEY" Target="EVCC_API_KEY" Default="" Mode="" Description="evcc API key" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="ORS_KEY" Target="ORS_KEY" Default="" Mode="" Description="OpenRouteService API key" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Time zone" Target="TZ" Default="Europe/Berlin" Mode="" Description="Container time zone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
</Container>
